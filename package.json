{
  "name": "dsh-session-cost-twd",
  "version": "0.1.1",
  "description": "DSH composer pills: estimated session spend in TWD and the DeepSeek wallet balance.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "cost",
    "balance",
    "twd"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stansu/dsh-session-cost-twd.git"
  },
  "homepage": "https://github.com/stansu/dsh-session-cost-twd#readme",
  "bugs": {
    "url": "https://github.com/stansu/dsh-session-cost-twd/issues"
  }
}
